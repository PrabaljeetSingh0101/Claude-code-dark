  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": {
      "foreground": "#4EBA65"
    },
    "interface": {
      "foreground": "#4EBA65"
    },
    "type": {
      "foreground": "#4EBA65"
    },
    "enum": {
      "foreground": "#4EBA65"
    },
    "namespace": {
      "foreground": "#E8E4DC"
    },
    "function": {
      "foreground": "#FAC35F"
    },
    "method": {
      "foreground": "#BAD0EC"
    },
    "macro": {
      "foreground": "#FAC35F"
    },
    "variable": {
      "foreground": "#E8E4DC"
    },
    "variable.readonly": {
      "foreground": "#827DBD"
    },
    "variable.defaultLibrary": {
      "foreground": "#827DBD"
    },
    "property": {
      "foreground": "#E8E4DC"
    },
    "parameter": {
      "foreground": "#E8E4DC"
    },
    "keyword": {
      "foreground": "#D77757"
    },
    "string": {
      "foreground": "#4EBA65"
    },
    "number": {
      "foreground": "#827DBD"
    },
    "boolean": {
      "foreground": "#827DBD"
    },
    "comment": {
      "foreground": "#999999"
    }
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#999999"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#D77757"
      }
    },
    {
      "name": "Storage Types",
      "scope": [
        "storage.type",
        "storage.type.modifier"
      ],
      "settings": {
        "foreground": "#6A9BCC"
      }
    },
    {
      "name": "Storage Modifiers & Keywords",
      "scope": [
        "storage",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#D77757"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#4EBA65"
      }
    },
    {
      "name": "Numbers & Booleans",
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.null"
      ],
      "settings": {
        "foreground": "#827DBD"
      }
    },
    {
      "name": "Constants & Language Variables",
      "scope": [
        "entity.name.constant",
        "variable.other.constant",
        "variable.other.enummember",
        "variable.language",
        "constant.language"
      ],
      "settings": {
        "foreground": "#827DBD"
      }
    },
    {
      "name": "Function Definitions",
      "scope": [
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#FAC35F"
      }
    },
    {
      "name": "Function & Method Calls",
      "scope": [
        "support.function",
        "meta.function-call",
        "entity.name.function.member",
        "meta.method-call"
      ],
      "settings": {
        "foreground": "#BAD0EC"
      }
    },
    {
      "name": "Types & Classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#4EBA65"
      }
    },
    {
      "name": "Variables & Namespaces",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#E8E4DC"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#C3C2B7"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#999999"
      }
    },
    {
      "name": "Object Properties",
      "scope": [
        "meta.object-literal.key",
        "variable.other.property"
      ],
      "settings": {
        "foreground": "#E8E4DC"
      }
    },
    {
      "name": "HTML/XML Tags",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#6A9BCC"
      }
    },
    {
      "name": "HTML/XML Attributes & CSS Pseudo-classes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.pseudo-class",
        "entity.other.pseudo-element"
      ],
      "settings": {
        "foreground": "#FAC35F"
      }
    },
    {
      "name": "CSS Selectors",
      "scope": [
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.id"
      ],
      "settings": {
        "foreground": "#FAC35F"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#6A9BCC"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#D77757"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#6A9BCC"
      }
    },
    {
      "name": "Markdown Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Invalid & Deprecated",
      "scope": [
        "invalid",
        "invalid.deprecated"
      ],
      "settings": {
        "fontStyle": "underline",
        "foreground": "#FF6B80"
      }
    },
    {
      "name": "Inherited Classes",
      "scope": [
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#6A9BCC"
      }
    },
    {
      "name": "C/C++ Macros",
      "scope": [
        "entity.name.function.preprocessor",
        "entity.name.constant.preprocessor",
        "meta.preprocessor.macro"
      ],
      "settings": {
        "foreground": "#FAC35F"
      }
    }
  ]
}